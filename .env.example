# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Chapa
EXPO_PUBLIC_CHAPA_PUBLIC_KEY=CHAPUBK_your_key
EXPO_PUBLIC_CHAPA_SECRET_KEY=CHASECK_your_key
EXPO_PUBLIC_CHAPA_WEBHOOK_SECRET=your_webhook_secret

# Website (marketing) vs API (webhook-server on Vercel)
EXPO_PUBLIC_APP_URL=https://mescott.co
EXPO_PUBLIC_API_URL=https://api.mescott.co

# Telegram sign-in — must match TELEGRAM_BOT_USERNAME in webhook-server/.env (no @)
EXPO_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername

# Server-only secrets live in webhook-server/.env (see webhook-server/.env.example)
