# ============================================
# Mescott - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# Supabase Configuration
# ============================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# Chapa Payment Gateway Configuration
# ============================================
# Get these from your Chapa dashboard:
# https://dashboard.chapa.co/account/settings/api
EXPO_PUBLIC_CHAPA_PUBLIC_KEY=CHAPUBK_your_public_key_here
EXPO_PUBLIC_CHAPA_SECRET_KEY=CHASECK_your_secret_key_here

# Webhook secret for verifying Chapa webhook signatures
# Set this in your Chapa dashboard under Webhooks settings
# IMPORTANT: Change this from the default value in production!
EXPO_PUBLIC_CHAPA_WEBHOOK_SECRET=your_secure_webhook_secret_here

# ============================================
# Application URLs
# ============================================
# Your webhook server URL (where Chapa will send payment notifications)
# Example: https://your-app.vercel.app or https://your-domain.com
EXPO_PUBLIC_API_URL=https://your-webhook-server-url.com

# Your app's return URL (where users are redirected after payment)
# For mobile apps, this is typically a deep link or web URL
# Example: https://mescott.com/payment-success or mescott://payment-success
EXPO_PUBLIC_APP_URL=https://your-app-domain.com

# ============================================
# Optional: Environment
# ============================================
# Set to 'production' for production builds
# Leave unset or 'development' for development
# NODE_ENV=development
