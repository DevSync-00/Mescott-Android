{
  "expo": {
    "name": "Mescott",
    "slug": "mescott",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/adaptive-icon.png",
    "scheme": "mescott",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Connect with skilled professionals for any task. Post jobs or offer your services on Ethiopia's leading marketplace platform.",
    "platforms": [
      "android",
      "web"
    ],
    "githubUrl": "https://github.com/berbir12/muyacon1",
    "primaryColor": "#7B42F6",
    "android": {
      "package": "com.mescott.app",
      "versionCode": 606,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon-light.png",
          "imageWidth": 200,
          "backgroundColor": "#7B42F6",
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them in your profile and tasks.",
          "cameraPermission": "The app accesses your camera to let you take photos for your profile and tasks."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notify.png",
          "color": "#7B42F6",
          "defaultChannel": "default"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "27ea2f57-78e0-41cd-8c6e-e3f56609c50b"
      }
    },
    "owner": "berbir"
  }
}
