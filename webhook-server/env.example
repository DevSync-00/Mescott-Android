# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Chapa Webhook Configuration
CHAPA_WEBHOOK_SECRET=qwertyuil@1A

# Telegram Bot (sign-up / sign-in verification + support)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# Letters, numbers, _ and - only (no @ or spaces). Example:
# TELEGRAM_WEBHOOK_SECRET=mescott_webhook_a1b2c3d4e5f6
TELEGRAM_WEBHOOK_SECRET=change_me_use_underscores_or_hyphens_only
TELEGRAM_WEBHOOK_BASE_URL=https://api.mescott.co
TELEGRAM_BOT_USERNAME=YourBotUsernameWithoutAt
EXPO_PUBLIC_API_URL=https://api.mescott.co
EXPO_PUBLIC_APP_URL=https://mescott.co
TELEGRAM_INTERNAL_API_KEY=optional_key_for_send_and_messages_api
TELEGRAM_OTP_TTL_MINUTES=10

# Use service role on server for inserts (recommended)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: For local development
NODE_ENV=development
LOG_LEVEL=info
